FROM ubuntu:24.04

# Nastavení non-interactive režimu
ENV DEBIAN_FRONTEND=noninteractive

# Instalace systémových závislostí
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    git \
    wget \
    gnupg \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalace Python 3.12.3 ze source (Ubuntu repo může mít jinou patch verzi)
WORKDIR /tmp

RUN wget https://www.python.org/ftp/python/3.12.3/Python-3.12.3.tgz --no-check-certificate && \
    tar -xzf Python-3.12.3.tgz && \
    cd Python-3.12.3 && \
    ./configure --enable-optimizations && \
    make -j$(nproc) && \
    make altinstall

# Nastavení python3.12 jako default
RUN ln -sf /usr/local/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/local/bin/pip3.12 /usr/bin/pip3

# Vyčištění
RUN rm -rf /tmp/Python-3.12.3*

# Nastavení pracovního adresáře
WORKDIR /var/www

# Kopírování requirements
COPY requirements.txt .

# Instalace Python knihoven
RUN pip3.12 install --upgrade pip
RUN pip3.12 install --no-cache-dir -r requirements.txt

# Kopírování nezbytných adresářů
COPY alembic.ini .
COPY src/glucose_viewer/ ./src/glucose_viewer/
COPY src/shared/ ./src/shared/
COPY DockerImages/Glucosestart.sh .

# Povolení start skriptu
RUN chmod +x Glucosestart.sh

EXPOSE 8080
# Start containeru přes start skript
CMD [". Glucosestart.sh"]
