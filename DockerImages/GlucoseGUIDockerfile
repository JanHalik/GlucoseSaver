# ==========
# BUILD STAGE
# ==========
FROM node:22-bookworm AS builder

# Instalace systémových závislostí
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Nastavení pracovního adresáře
WORKDIR /var/www/

# kopíruj pouze definice závislostí
COPY src/glucose-app/package*.json ./

RUN npm ci

# zbytek zdrojáků
COPY src/glucose-app/ ./

# build React aplikace
RUN npm run build

# ==========
# RUNTIME STAGE
# ==========
FROM nginx:alpine

# smaž default nginx config
RUN rm -rf /usr/share/nginx/html/*

# zkopírujeme build
COPY --from=builder /var/www/dist /usr/share/nginx/html/provisioning




COPY src/glucose-app/env.template.js /usr/share/nginx/html/provisioning/env.template.js
COPY scripts/docker-gui-entrypoint.sh /docker-gui-entrypoint.sh
RUN chmod +x /docker-gui-entrypoint.sh

# vlastní nginx konfigurace
COPY src/glucose-app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

ENTRYPOINT ["/docker-gui-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]